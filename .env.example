# Get keys at https://aistudio.google.com/apikey
#
# At least one is required. Extra keys are optional: Palat rotates to the next
# one when a key hits its quota, so several free-tier keys behave like a bigger
# daily cap. Extras can also be given as a comma-separated GEMINI_API_KEYS.
GEMINI_API_KEY=paste_your_key_here
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional. Defaults to gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash
